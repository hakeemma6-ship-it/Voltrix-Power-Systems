# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL & ADMIN_PASSWORD: Safe administrator clearance configuration.
ADMIN_EMAIL="admin@voltrixpower.com"
ADMIN_PASSWORD="admin123"

# JWT Secret for secure signing
JWT_SECRET="voltrix_secret_jwt_key_2026_change_me_in_dev"

# MongoDB Connection String URI
MONGOURI=

# Cloudinary parameters
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auth0 configurations for Google Login
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# WhatsApp Cloud API credentials
WHATSAPP_ACCESS_TOKEN="YOUR_WHATSAPP_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_WHATSAPP_PHONE_NUMBER_ID"
WHATSAPP_BUSINESS_ACCOUNT_ID="YOUR_WHATSAPP_WABA_ID"
WHATSAPP_WABA_ID="YOUR_WHATSAPP_WABA_ID"
META_APP_ID="YOUR_META_APP_ID"
META_APP_SECRET="YOUR_META_APP_SECRET"
WHATSAPP_VERIFY_TOKEN="YOUR_WHATSAPP_VERIFY_TOKEN"
WHATSAPP_TEMPLATE_LANGUAGE=en

# 2Factor.in SMS OTP API
TWOFACTOR_API_KEY=
TWOFACTOR_OTP_TEMPLATE=
